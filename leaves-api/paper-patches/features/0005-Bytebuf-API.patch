diff --git a/src/main/java/org/bukkit/Bukkit.java b/src/main/java/org/bukkit/Bukkit.java
index 23d26e12670e23b7a5b2be3d1e2279edc9331571..25b9a4b5337da4d1ff32e33319b1116a875f4688 100644
