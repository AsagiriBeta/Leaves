From: LeavesMC Test CI <ci-test@leavesmc.org>
Date: Fri, 28 Aug 2026 09:35:35 +0000
Subject: [PATCH] Skip Paper version lookup for Leaves startup.


diff --git a/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java b/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
index ea626c7701f52e23d288db0cdacc0df8a8207e2a..ee012fc23d5b786fa3d377bf4d3274d2f2693ea6 100644
--- a/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
+++ b/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
@@ -65,6 +65,12 @@ public class PaperVersionFetcher implements VersionFetcher {
     }
 
     public static void getUpdateStatusStartupMessage() {
+        // Leaves start - official Paper fill/GitHub checks do not apply to Leaves builds
+        if ("Leaves".equals(BUILD_INFO.brandName())) {
+            org.leavesmc.leaves.util.LeavesVersionFetcher.logStartupVersionStatus();
+            return;
+        }
+        // Leaves end
         int distance = DISTANCE_ERROR;
 
         final OptionalInt buildNumber = BUILD_INFO.buildNumber();
